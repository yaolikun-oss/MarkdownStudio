{
  "name": "markdown-studio-windows",
  "productName": "Markdown Studio",
  "version": "0.2.0",
  "private": true,
  "description": "Markdown Studio for Windows — reading and Markdown notes",
  "author": "Markdown Studio",
  "license": "UNLICENSED",
  "main": "build/electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build && node scripts/build-main.mjs",
    "start": "electron .",
    "package:win": "npm run build && npm run notices && electron-builder --win zip --x64",
    "package:mac-qa": "npm run build && npm run notices && electron-builder --mac dir --arm64",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit",
    "notices": "node scripts/notices.mjs"
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/language": "6.13.1",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@tiptap/core": "3.32.0",
    "@tiptap/extension-bold": "3.32.0",
    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/extension-underline": "3.32.0",
    "@tiptap/markdown": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "docx-preview": "0.4.1",
    "dompurify": "3.4.17",
    "epubjs": "0.3.93",
    "marked": "18.1.1",
    "pdfjs-dist": "6.4.299",
    "@lezer/highlight": "1.2.5"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "electron": "45.0.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  },
  "build": {
    "appId": "local.markdownstudio.windows",
    "productName": "Markdown Studio",
    "directories": {
      "output": "release"
    },
    "files": [
      "build/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "asar": true,
    "win": {
      "target": [
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MarkdownStudio-Windows-${version}-x64.${ext}",
      "signExecutable": false,
      "icon": "assets/icon.ico"
    },
    "mac": {
      "identity": null,
      "category": "public.app-category.productivity",
      "artifactName": "MarkdownStudio-Windows-QA-${version}.${ext}"
    },
    "npmRebuild": false,
    "extraFiles": [
      {
        "from": "README.md",
        "to": "使用说明.md"
      },
      {
        "from": "THIRD_PARTY_NOTICES.txt",
        "to": "THIRD_PARTY_NOTICES.txt"
      },
      {
        "from": "QA.md",
        "to": "QA.md"
      }
    ]
  },
  "overrides": {
    "epubjs": {
      "@xmldom/xmldom": "0.9.12"
    }
  },
  "type": "module"
}
